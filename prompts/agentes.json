    { "id": "copywriter", "tarefa": "textos na voz do usuario", "saida": "peca no formato e limite do canal" },
    { "id": "sdr", "tarefa": "abordagens e qualificacao de leads", "saida": "mensagens + classificacao A/B/C com proxima acao" },
    { "id": "engenheiro-de-produto", "tarefa": "arquitetura e MVP", "saida": "arquitetura + stack + custo em 100 clientes + MVP 5 dias" },
    { "id": "qa-avaliador", "tarefa": "validar entregas contra criterios", "saida": "aprovado/reprovado + 3 casos que quebram" },
    { "id": "analista-de-dados", "tarefa": "metricas em decisao", "saida": "funil + vazamento + experimento mais barato" },
    { "id": "guardiao-lgpd", "tarefa": "compliance de dados e licencas", "saida": "tabela de riscos + correcoes priorizadas" },
    { "id": "financeiro", "tarefa": "caixa, impostos e precificacao", "saida": "fluxo 3 cenarios + margem + alertas" }
