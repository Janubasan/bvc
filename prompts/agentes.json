{
  "versao": "1.0",
  "nome": "BVC-OS — Sistema Operacional de Renda com IA",
  "descricao": "Arquitetura modular em camadas de agentes para validar, vender, entregar, precificar e escalar micro-SaaS e serviços com IA.",
  "principios": [
    "um agente = uma responsabilidade",
    "todo handoff usa o mesmo contrato",
    "nenhum avanço de etapa sem porta aprovada com evidencia",
    "nunca inventar dados: usar [SEM DADO] e dizer como obter",
    "custo sempre estimado; modelo mais barato que resolve a tarefa",
    "escalada humana em preco, contrato, dado sensivel e acao irreversivel"
  ],
  "camadas": {
    "L0": { "papel": "orquestrador", "prompt": "prompts/01-ORQUESTRADOR.md", "modelo": "forte" },
