      "consome": ["dores_comprovadas", "custo_atual_do_cliente", "concorrentes_precos", "capacidade_entrega"],
      "produz": ["oferta_1_frase", "3_planos", "garantia", "proposta_1_pagina", "script_10_objecoes", "regra_desconto"],
      "especialistas": ["copywriter", "pesquisador", "financeiro"],
