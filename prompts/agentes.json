    "L2": { "papel": "especialistas (workers)", "prompt": "prompts/03-AGENTES-L2.md", "modelo": "pequeno/local" },
    "L3": { "papel": "servicos compartilhados (memoria, RAG em docs/ e dados/, telemetria)", "modelo": "-" },
    "L4": { "papel": "guardrails (formato, dados, licenca, LGPD, custo, promessa)", "prompt": "prompts/04-CONTRATOS-E-PORTAS.md", "modelo": "medio" }
  },
  "agentes_l1": [
