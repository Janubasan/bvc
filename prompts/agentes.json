      "consome": ["escopo_vendido", "prazo", "garantia", "stack", "dados_cliente"],
      "produz": ["plano_entrega_marcos", "stack_justificada_custo", "automacao_guardrails", "medicao_antes_depois", "onboarding_7d", "checklist_qa", "registro_processo"],
