  "portas": {
    "G0": { "nome": "Dor real", "criterio": ">=15 conversas e >=5 com gasto em dinheiro/tempo", "libera": "construir" },
    "G1": { "nome": "Sinal de dinheiro", "criterio": ">=3 pagos/pre-pagos/cartas assinadas", "libera": "investir em produto" },
    "G2": { "nome": "Entrega", "criterio": "1 cliente com resultado medido + depoimento", "libera": "escalar venda" },
    "G3": { "nome": "Recorrencia", "criterio": ">=3 mensalidades ativas + 1 renovacao", "libera": "virar produto" },
    "G4": { "nome": "Canal", "criterio": ">=10 clientes do mesmo canal + CAC conhecido", "libera": "2o canal" },
    "G5": { "nome": "Margem", "criterio": "custo IA+infra <30% da receita por 2 meses", "libera": "escalar volume" },
    "G6": { "nome": "Sistema", "criterio": "4 semanas sem intervencao manual critica", "libera": "portfolio/2o produto" }
  },
  "percursos": {
    "P1": { "nome": "Caixa rapido", "prazo": "0-30d", "entregas": ["oferta", "100 contatos", "10 conversas", "3 pagantes", "1 entrega medida"], "portas": ["G0", "G1", "G2"] },
    "P2": { "nome": "Recorrencia", "prazo": "30-60d", "entregas": ["empacotar mensal", "3 mensalidades", "ritual de valor mensal"], "portas": ["G3"] },
    "P3": { "nome": "Produto", "prazo": "60-90d", "entregas": ["PRD", "MVP", "migrar clientes", "cobrar software"], "portas": ["G3"] },
    "P4": { "nome": "Canal", "prazo": "90-180d", "entregas": ["1 canal dominado", "90 dias de conteudo/outbound", "CAC conhecido"], "portas": ["G4"] },
    "P5": { "nome": "Portfolio/Escala", "prazo": "180d+", "entregas": ["automacao", "parceiros/white-label", "margem >70%", "2o produto ou aquisicao"], "portas": ["G5", "G6"] }
  },
  "contrato_handoff": {
    "obrigatorios": ["id", "de", "para", "objetivo", "saida_esperada", "criterios_aceitacao", "prazo", "status"],
    "opcionais": ["contexto", "entrada", "custo_estimado", "resultado", "evidencia", "aprendizado"],
    "status_validos": ["pendente", "em_curso", "bloqueado", "pronto", "reprovado"],
    "codigos_reprovacao": {
      "E-FMT": "saida fora do formato",
      "E-DADO": "numero sem fonte ou inventado",
      "E-LIC": "licenca incompativel com uso comercial",
      "E-LGPD": "dado pessoal sem base legal ou minimizacao",
      "E-CUSTO": "custo estimado acima de 30% da receita",
      "E-PROMESSA": "promessa de renda ou garantia nao controlavel",
      "E-ESCOPO": "tarefa mistura duas responsabilidades"
    }
  },
  "comandos": ["/iniciar", "/status", "/proximo", "/validar", "/preencher", "/porteiro", "/porta", "/canal", "/entrega", "/caixa", "/auditoria", "/semana", "/escalar"],
  "formato_resposta": ["diagnostico", "decisao", "handoffs", "artefato", "acao_de_hoje", "atualizacao_estado", "proximo_passo"],
  "guardrails_l4": [
    "validacao de schema/formatacao",
    "checagem de numeros e fontes",
    "checagem de licencas (docs/03 e docs/04)",
    "checagem de LGPD (docs/10)",
    "estimativa e teto de custo",
