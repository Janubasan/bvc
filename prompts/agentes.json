      "consome": ["receita_recebida", "mrr", "custos", "churn", "ativacao", "cobranca"],
      "produz": ["painel_8_numeros", "fluxo_90_dias_3_cenarios", "plano_cobranca_dunning", "plano_anti_churn", "otimizacao_custo_ia", "checklist_formalizacao_br"],
